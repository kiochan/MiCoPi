{
  "api_version": 1,
  "id": "layers",
  "name": "Layers window",
  "requires": [
    "workbench"
  ],
  "panels": [
    {
      "id": "layers",
      "title": "Layers",
      "builtin": "layers"
    }
  ],
  "actions": [
    {
      "id": "group.inspect",
      "title": "Inspect Group Properties",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "group.inspect",
            "value": {
              "$arg": "group_id"
            }
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "group_id"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "document_atomic": false
    },
    {
      "id": "layer.merge_selected.open",
      "title": "Review Selected Merge",
      "operation": "open_selected_merge",
      "output_schema": {
        "type": "object",
        "properties": {
          "queued": {
            "type": "boolean"
          },
          "applied": {
            "type": "boolean"
          },
          "runtime": {
            "type": "string"
          }
        },
        "required": [
          "queued",
          "applied",
          "runtime"
        ]
      }
    }
  ]
}
