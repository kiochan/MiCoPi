{
  "api_version": 1,
  "id": "workbench",
  "name": "Workbench panels",
  "requires": [
    "core",
    "painting"
  ],
  "actions": [
    {
      "id": "view.set",
      "title": "Set zoom and pan",
      "operation": "view"
    },
    {
      "id": "ui.dispatch",
      "title": "Dispatch a presentation action",
      "operation": "ui"
    },
    {
      "id": "workspace.reset",
      "title": "Reset Layout",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "command",
            "value": {
              "UiCommand": 10121
            }
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "workspace.focus",
      "title": "Toggle Focus Mode",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "command",
            "value": "TogglePanels"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "workspace.merge_color_brush",
      "title": "Group Color and Brush",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "command",
            "value": {
              "UiCommand": 10122
            }
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "workspace.merge_navigation_layers",
      "title": "Group Navigator and Layers",
