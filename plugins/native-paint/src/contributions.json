{
  "id": "native_paint",
  "actions": [
    {
      "id": "native.invert",
      "title": "Invert Current Layer (Native DLL)",
      "native": "invert",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "document_atomic": true
    },
    {
      "id": "native.checkerboard",
      "title": "Generate Checkerboard (Native DLL)",
      "native": "checkerboard",
      "input_schema": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "additionalProperties": false
      },
      "document_atomic": true
    },
    {
      "id": "native.invert_region",
      "title": "Invert Region (Native DLL)",
      "native": "invert_region",
      "input_schema": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "document_atomic": true
    },
    {
      "id": "native.stats",
      "title": "Query Native Plugin Instance",
      "native": "stats",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "read_only": true,
      "output_schema": {
        "type": "object",
        "properties": {
          "calls": {
            "type": "integer"
          },
          "implementation": {
            "type": "string"
          }
        },
        "required": [
          "calls",
          "implementation"
        ]
      }
    },
    {
      "id": "layer.flip_horizontal",
      "title": "Flip Layer Horizontally",
      "native": "flip_horizontal",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "layer.flip_vertical",
      "title": "Flip Layer Vertically",
      "native": "flip_vertical",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "layer.rotate_180",
      "title": "Rotate Layer 180°",
      "native": "rotate_180",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "layer.translate",
      "title": "Offset Layer",
      "native": "translate",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "dx": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          },
          "dy": {
            "type": "integer",
            "minimum": -4096,
            "maximum": 4096
          }
        },
        "required": [
          "dx",
          "dy"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "layer.fill",
      "title": "Flood Fill",
      "native": "fill",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "color": {
            "type": "string"
          },
          "tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "x",
          "y",
          "color"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "layer.gradient",
      "title": "Gradient",
      "native": "gradient",
      "document_atomic": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "x0": {
            "type": "number",
            "minimum": -4096,
            "maximum": 8192
          },
          "y0": {
            "type": "number",
            "minimum": -4096,
            "maximum": 8192
          },
          "x1": {
            "type": "number",
            "minimum": -4096,
            "maximum": 8192
          },
          "y1": {
            "type": "number",
            "minimum": -4096,
            "maximum": 8192
          },
          "start_color": {
            "type": "string"
          },
          "end_color": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "linear",
              "radial"
            ]
          }
        },
        "required": [
          "x0",
          "y0",
          "x1",
          "y1",
          "start_color",
          "end_color"
        ],
        "additionalProperties": false
      }
    }
  ],
  "panels": [
    {
      "id": "native_paint.panel",
      "title": "Native Plugin",
      "buttons": [
        {
          "title": "Generate Checkerboard · DLL",
          "action": {
            "action": "native.checkerboard",
            "args": {
              "cell": 32
            }
          }
        },
        {
          "title": "Invert Current Layer · DLL",
          "action": {
            "action": "native.invert"
          }
        },
        {
          "title": "Undo",
          "action": {
            "action": "history.undo"
          }
        }
      ]
    }
  ],
  "states": [
    {
      "id": "native_paint.stats",
      "title": "Native painting DLL instance statistics",
      "action": "native.stats",
      "output_schema": {
        "type": "object",
        "required": [
          "calls",
          "implementation"
        ],
        "properties": {
          "calls": {
            "type": "integer"
          },
          "implementation": {
            "type": "string"
          }
        }
      }
    }
  ],
  "nodes": [
    {
      "id": "native_paint.statistics",
      "title": "Painting DLL Statistics",
      "category": "Plugin Examples",
      "binding": {
        "kind": "state",
        "resource": "native_paint.stats"
      }
    }
  ]
}
