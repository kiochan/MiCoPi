                    "owner": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 96,
                      "pattern": "^[a-z0-9._-]+$"
                    },
                    "tool_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 96,
                      "pattern": "^[a-z0-9._-]+$"
                    },
                    "parameters": {
                      "type": "object",
                      "additionalProperties": false,
