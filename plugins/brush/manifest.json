                "minimum": 1,
                "maximum": 4294967296
              },
              "items": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "owner",
                    "tool_id",
                    "parameters"
