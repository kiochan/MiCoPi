        "type": "object",
        "properties": {
          "parameters": {
            "type": "object",
            "properties": {
              "tip_shape": {
                "type": "string",
                "enum": [
                  "round",
                  "square"
                ],
                "description": "Analytic Round or Square tip; omitted values resolve to Round."
              },
              "tip_roundness": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 1,
                "description": "Minor/major axis ratio; omitted values resolve to 1."
              },
              "tip_angle": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "Fixed clockwise document degrees; omitted values resolve to 0."
              },
              "symmetry": {
                "type": "string",
                "enum": [
                  "off",
                  "vertical",
                  "horizontal",
                  "both"
                ],
                "default": "off",
                "title": "Brush Symmetry"
              },
              "symmetry_x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5,
                "title": "Symmetry X Anchor"
              },
              "symmetry_y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5,
                "title": "Symmetry Y Anchor"
              }
            },
            "required": [
              "tip_shape",
              "tip_roundness",
              "tip_angle"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "parameters",
          "revision"
        ],
        "additionalProperties": false
      }
    },
