                          "minimum": 0,
                          "maximum": 1
                        },
                        "spacing": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 2
                        },
                        "minimum_opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "flow": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
