{
  "api_version": 1,
  "id": "brush",
  "name": "Brush window",
  "requires": [
    "workbench",
    "painting"
  ],
  "panels": [
    {
      "id": "brush",
      "title": "Brush",
      "builtin": "brush"
    }
  ],
  "actions": [
    {
      "id": "brush.presets.upsert",
      "title": "Save User Brush Preset",
      "operation": "brush_preset_upsert",
      "output_schema": {
        "type": "object",
        "properties": {
          "preset_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "library_token": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "preset_id",
          "library_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "brush.presets.delete",
      "title": "Delete User Brush Preset",
      "operation": "brush_preset_delete",
      "output_schema": {
        "type": "object",
        "properties": {
          "deleted_preset_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "library_token": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "deleted_preset_id",
          "library_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "brush.presets.apply",
      "title": "Apply User Brush Preset",
      "operation": "brush_preset_apply",
      "output_schema": {
        "type": "object",
        "properties": {
          "preset_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "selected_tool": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "preset_id",
          "selected_tool",
          "parameters",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "brush.presets.import",
      "title": "Import Brush Presets",
      "operation": "brush_presets_import",
      "output_schema": {
        "type": "object",
        "properties": {
          "imported_ids": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "id_map": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "preset_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              },
              "required": [
                "source_id",
                "preset_id"
              ],
              "additionalProperties": false
            }
          },
          "library_token": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "required": [
          "imported_ids",
          "id_map",
          "library_token",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "brush.presets.export",
      "title": "Export Brush Presets",
      "operation": "brush_presets_export",
      "output_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "preset_ids": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "sha256": {
            "type": "string",
            "minLength": 64
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "required": [
          "path",
          "preset_ids",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "brush.presets.reload",
      "title": "Reload Brush Preset Library",
      "operation": "brush_presets_reload",
      "output_schema": {
        "type": "object",
        "properties": {
          "library_token": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "library_token"
        ],
        "additionalProperties": false
      }
    }
  ]
}
