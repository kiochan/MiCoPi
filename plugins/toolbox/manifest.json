{
  "api_version": 1,
  "id": "toolbox",
  "name": "Tools window",
  "requires": [
    "workbench",
    "painting"
  ],
  "panels": [
    {
      "id": "toolbox",
      "title": "Tools",
      "builtin": "tools"
    },
    {
      "id": "tool-options",
      "title": "Tool Options",
      "builtin": "tool_options"
    }
  ],
  "actions": [
    {
      "id": "toolbox.mode.brush",
      "title": "Paint with Brush",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "brush"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.fill",
      "title": "Activate Flood Fill",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "fill"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.gradient",
      "title": "Activate Gradient",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "gradient"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.selection_rectangle",
      "title": "Rectangular Marquee",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "selection_rectangle"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.selection_ellipse",
      "title": "Elliptical Marquee",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "selection_ellipse"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.selection_lasso",
      "title": "Lasso",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "selection_lasso"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.selection_polygon",
      "title": "Polygonal Lasso",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "selection_polygon"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.selection.replace",
      "title": "New Selection",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "selection.combine",
            "value": "replace"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.selection.add",
      "title": "Add to Selection",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "selection.combine",
            "value": "add"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.selection.subtract",
      "title": "Subtract from Selection",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "selection.combine",
            "value": "subtract"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.selection.intersect",
      "title": "Intersect Selection",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "selection.combine",
            "value": "intersect"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.selection_wand",
      "title": "Magic Wand",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "selection_wand"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.selection.options",
      "title": "Selection Sampling Options",
      "input_schema": {
        "type": "object",
        "properties": {
          "tolerance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 32
          },
          "contiguous": {
            "type": "boolean",
            "default": true
          },
          "sample_merged": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "tolerance",
          "contiguous",
          "sample_merged"
        ],
        "additionalProperties": false
      },
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "selection.options",
            "value": {
              "tolerance": {
                "$arg": "tolerance"
              },
              "contiguous": {
                "$arg": "contiguous"
              },
              "sample_merged": {
                "$arg": "sample_merged"
              }
            }
          }
        }
      ]
    },
    {
      "id": "toolbox.mode.move",
      "title": "Move Tool",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "move"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.movement.options",
      "title": "Move Tool Options",
      "input_schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "auto",
              "layer",
              "selection",
              "selection_mask"
            ]
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "large_step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "target",
          "step",
          "large_step"
        ],
        "additionalProperties": false
      },
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "movement.options",
            "value": {
              "target": {
                "$arg": "target"
              },
              "step": {
                "$arg": "step"
              },
              "large_step": {
                "$arg": "large_step"
              }
            }
          }
        }
      ]
    }
  ]
}
