{
  "api_version": 1,
  "id": "toolbox",
  "name": "Tools window",
  "requires": [
    "workbench",
    "painting"
  ],
  "panels": [
    {
      "id": "toolbox",
      "title": "Tools",
      "builtin": "tools"
    },
    {
      "id": "tool-options",
      "title": "Tool Options",
      "builtin": "tool_options"
    }
  ],
  "actions": [
    {
      "id": "toolbox.mode.brush",
      "title": "Paint with Brush",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "brush"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.fill",
      "title": "Activate Flood Fill",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "fill"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "toolbox.mode.gradient",
      "title": "Activate Gradient",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "painting.mode",
            "value": "gradient"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ]
}
