{
  "api_version": 1,
  "id": "compositing",
  "name": "Node compositing",
  "requires": [
    "core"
  ],
  "library": "micopi_compositing.dll",
  "actions": [
    {
      "id": "graph.read",
      "title": "Read Image Graph",
      "operation": "graph_read",
      "output_schema": {
        "type": "object",
        "properties": {
          "available_blend_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "multiply",
                "screen",
                "overlay",
                "darken",
                "lighten",
                "add",
                "difference",
                "color_burn",
                "linear_burn",
                "darker_color",
                "color_dodge",
                "lighter_color",
                "soft_light",
                "hard_light",
                "vivid_light",
                "linear_light",
                "pin_light",
                "hard_mix",
                "exclusion",
                "subtract",
                "divide",
                "hue",
                "saturation",
                "color",
                "luminosity"
              ]
            },
            "maxItems": 26,
            "description": "Currently available modes, including the CPU Normal fallback; known but unsupported modes remain in graph.catalog.blend_modes."
          },
          "renderer_mix": {
            "type": "boolean",
            "description": "The loaded compositor supports premultiplied backdrop mixing."
          },
          "renderer_levels": {
            "type": "boolean",
            "description": "The loaded compositor supports scalar Levels preparation/rendering."
          },
          "renderer_curves": {
            "type": "boolean",
            "description": "The loaded compositor supports Curves preparation/rendering."
          },
          "renderer_channel_levels": {
            "type": "boolean",
            "description": "The loaded compositor negotiated channel Levels preparation and three-table rendering."
          },
          "renderer_histogram_plan": {
            "type": "boolean",
            "description": "The active document renderer supports bounded prepared-plan histogram observations."
          },
          "histogram_views": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "description": "Published source declarations, including disabled effects; IDs require the current document/revision."
              },
              "actual": {
                "type": "object",
                "description": "Actual composition, including disabled flat-filter bypass, masks and group gates. IDs belong only to this view/revision."
              }
            },
            "required": [
              "source",
              "actual"
            ],
            "additionalProperties": false
          },
          "document_identity": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "renderer_hsl": {
            "type": "boolean",
            "description": "The active document renderer supports native HSL plans."
          },
          "renderer_quantization": {
            "type": "boolean"
          }
        },
        "required": [
          "available_blend_modes",
          "renderer_mix",
          "renderer_levels",
          "renderer_curves",
          "renderer_channel_levels",
          "renderer_histogram_plan",
          "histogram_views",
          "document_identity",
          "revision"
        ]
      }
    },
    {
      "id": "graph.set",
      "title": "Apply Non-destructive Image Graph",
      "operation": "graph_set"
    },
    {
      "id": "graph.catalog",
      "title": "List Filters and Blend Modes",
      "operation": "graph_catalog",
      "output_schema": {
        "type": "object",
        "properties": {
          "available_blend_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "multiply",
                "screen",
                "overlay",
                "darken",
                "lighten",
                "add",
                "difference",
                "color_burn",
                "linear_burn",
                "darker_color",
                "color_dodge",
                "lighter_color",
                "soft_light",
                "hard_light",
                "vivid_light",
                "linear_light",
                "pin_light",
                "hard_mix",
                "exclusion",
                "subtract",
                "divide",
                "hue",
                "saturation",
                "color",
                "luminosity"
              ]
            },
            "maxItems": 26,
            "description": "Currently available modes, including the CPU Normal fallback; known but unsupported modes remain in graph.catalog.blend_modes."
          },
          "renderer_mix": {
            "type": "boolean",
            "description": "The loaded compositor supports premultiplied backdrop mixing."
          },
          "renderer_levels": {
            "type": "boolean",
            "description": "The loaded compositor supports scalar Levels preparation/rendering."
          },
          "renderer_curves": {
            "type": "boolean",
            "description": "The loaded compositor supports Curves preparation/rendering."
          },
          "renderer_channel_levels": {
            "type": "boolean",
            "description": "The loaded compositor negotiated channel Levels preparation and three-table rendering."
          },
          "renderer_histogram_plan": {
            "type": "boolean",
            "description": "The active document renderer supports bounded prepared-plan histogram observations."
          },
          "renderer_hsl": {
            "type": "boolean",
            "description": "The active document renderer supports native HSL plans."
          },
          "renderer_quantization": {
            "type": "boolean"
          }
        },
        "required": [
          "available_blend_modes",
          "renderer_mix",
          "renderer_levels",
          "renderer_curves",
          "renderer_channel_levels",
          "renderer_histogram_plan"
        ]
      }
    },
    {
      "id": "graph.open",
      "title": "Open Node Editor",
      "steps": [
        {
          "action": "ui.dispatch",
          "args": {
            "id": "nodes.open"
          }
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "id": "histogram.query",
      "title": "Read Color Histogram",
      "operation": "histogram_query",
      "output_schema": {
        "type": "object",
        "properties": {
          "document_identity": {
            "type": "integer",
            "minimum": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "composite",
              "layer",
              "node"
            ]
          },
          "layer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "total_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "max_samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "sampling": {
            "type": "string",
            "enum": [
              "grid_centers"
            ]
          },
          "grid_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "grid_height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "sampled_pixels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "nontransparent_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "ignored_transparent_pixels": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "exact": {
            "type": "boolean"
          },
          "red": {
            "type": "array",
            "title": "Red",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "green": {
            "type": "array",
            "title": "Green",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "blue": {
            "type": "array",
            "title": "Blue",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "rgb": {
            "type": "array",
            "title": "Master RGB",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 196608
            }
          },
          "graph_view": {
            "type": "string",
            "enum": [
              "source",
              "actual"
            ]
          },
          "node_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "resolved_node_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "graph_enabled": {
            "type": "boolean"
          },
          "evaluation": {
            "type": "string",
            "enum": [
              "source_declaration",
              "actual_plan"
            ]
          },
          "port": {
            "type": "string",
            "enum": [
              "input",
              "output"
            ]
          },
          "input_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "document_identity",
          "revision",
          "source",
          "width",
          "height",
          "total_pixels",
          "max_samples",
          "sampling",
          "grid_width",
          "grid_height",
          "sampled_pixels",
          "nontransparent_pixels",
          "ignored_transparent_pixels",
          "exact",
          "red",
          "green",
          "blue",
          "rgb"
        ],
        "additionalProperties": false
      }
    }
  ],
