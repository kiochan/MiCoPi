{
  "version": 1,
  "ui": {
    "theme": "graphite",
    "font_size": 14,
    "small_font_size": 12,
    "item_spacing": 8,
    "section_spacing": 16,
    "panel_padding": 12,
    "outer_padding": 8,
    "control_height": 30,
    "title_height": 40,
    "toolbar_height": 40,
    "tab_height": 34,
    "corner_radius": 5,
    "icon_size": 20,
    "left_panel_width": 244,
    "right_panel_width": 252,
    "canvas_margin": 32,
    "accent": "#76C7BA",
    "language": "en"
  },
  "keybindings": {
    "commands.open": [
      "Ctrl+Shift+P"
    ],
    "tool.brush": [
      "B",
      "Shift+B"
    ],
    "tool.eraser": [
      "E",
      "Shift+E"
    ]
  },
  "painting": {
    "stabilizer": 0.35,
    "pressure_size": true,
    "pressure_opacity": false,
    "pressure_gamma": 1,
    "minimum_radius": 0.08
  },
  "plugins": {
    "disabled": []
  }
}
