{
  "version": 1,
  "ui": {
    "theme": "graphite",
    "font_size": 13,
    "small_font_size": 12,
    "item_spacing": 4,
    "section_spacing": 12,
    "panel_padding": 8,
    "outer_padding": 6,
    "control_height": 26,
    "title_height": 36,
    "toolbar_height": 34,
    "tab_height": 30,
    "corner_radius": 8,
    "icon_size": 18,
    "left_panel_width": 244,
    "right_panel_width": 272,
    "canvas_margin": 24,
    "accent": "#B8A2E4",
    "language": "en",
    "toolbox_height": 80,
    "toolbox_width": 720
  },
  "keybindings": {
    "commands.open": [
      "Ctrl+Shift+P"
    ],
    "tool.brush": [
      "B",
      "Shift+B"
    ],
    "tool.eraser": [
      "E",
      "Shift+E"
    ]
  },
  "painting": {
    "stabilizer": 0.35,
    "pressure_size": true,
    "pressure_opacity": false,
    "pressure_gamma": 1,
    "minimum_radius": 0.08
  },
  "plugins": {
    "disabled": []
  }
}
