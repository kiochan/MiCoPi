{
  "version": 1,
  "keybindings": {
    "commands.open": [
      "Ctrl+Shift+P"
    ],
    "keybindings.edit": [
      "Ctrl+Alt+Shift+K"
    ],
    "tool.brush": [
      "V",
      "Shift+V"
    ],
    "tool.eraser": [
      "E",
      "Shift+E"
    ],
    "hold.pan": [
      "Space"
    ],
    "hold.pick": [
      "Alt"
    ],
    "wheel.zoom": [
      "Ctrl+Wheel"
    ],
    "wheel.horizontal": [
      "Shift+Wheel"
    ],
    "wheel.vertical": [
      "Wheel"
    ]
  },
  "ui": {
    "language": "en"
  },
  "selection": {
    "tolerance": 32,
    "contiguous": true,
    "sample_merged": false
  },
  "movement": {
    "target": "auto",
    "step": 1,
    "large_step": 10
  }
}
