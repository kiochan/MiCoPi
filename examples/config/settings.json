{
  "version": 1,
  "keybindings": {
    "commands.open": [
      "Ctrl+Shift+P"
    ],
    "keybindings.edit": [
      "Ctrl+Alt+Shift+K"
    ],
    "tool.brush": [
      "V",
      "Shift+V"
    ],
    "tool.eraser": [
      "E",
      "Shift+E"
    ],
    "hold.pan": [
      "Space"
    ],
    "hold.pick": [
      "Alt"
    ],
    "wheel.zoom": [
      "Ctrl+Wheel"
    ],
    "wheel.horizontal": [
      "Shift+Wheel"
    ],
    "wheel.vertical": [
      "Wheel"
    ]
  },
  "ui": {
    "language": "en"
  },
  "selection": {
    "tolerance": 32,
    "contiguous": true,
    "sample_merged": false
  },
  "movement": {
    "target": "auto",
    "step": 1,
    "large_step": 10
  },
  "new_canvas": {
    "default_preset": "a4",
    "presets": [
      {
        "id": "illustration",
        "name": "Illustration",
        "width": 1200,
        "height": 900,
        "resolution_ppi": 72,
        "background": "transparent"
      },
      {
        "id": "square",
        "name": "Square",
        "width": 2048,
        "height": 2048,
        "resolution_ppi": 300,
        "background": "transparent"
      },
      {
        "id": "a4",
        "name": "A4",
        "width": 2480,
        "height": 3508,
        "resolution_ppi": 300,
        "background": "#FFFFFF"
      },
      {
        "id": "b5",
        "name": "B5",
        "width": 2150,
        "height": 3035,
        "resolution_ppi": 300,
        "background": "#FFFFFF"
      },
      {
        "id": "comic-panel",
        "name": "Comic panel",
        "width": 1600,
        "height": 1200,
        "resolution_ppi": 300,
        "background": "#FFFFFF"
      }
    ]
  }
}
